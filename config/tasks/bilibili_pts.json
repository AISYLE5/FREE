{
  "id": "bilibili_pts",
  "name": "哔哩哔哩 · 积分",
  "package": "tv.danmaku.bili",
  "actions": [
    {
      "type": "stop"
    },
    {
      "type": "launch",
      "wait_seconds": 10.0
    },
    {
      "type": "click",
      "timeout_seconds": 30,
      "retries": 2,
      "locate": "ui",
      "target": "text",
      "texts": ["我的"],
      "match_mode": "exact"
    },
    {
      "type": "click",
      "timeout_seconds": 30,
      "retries": 2,
      "locate": "ui",
      "target": "text",
      "texts": ["大会员中心"],
      "match_mode": "exact"
    },
    {
      "name": "bilibili_ad",
      "type": "compound"
    },
    {
      "type": "swipe_until",
      "x1": 540,
      "y1": 1450,
      "x2": 540,
      "y2": 300,
      "duration_ms": 800,
      "locate": "ocr",
      "texts": [
        "签到",
        "已签到"
      ],
      "result_var": "state",
      "match_mode": "exact",
      "timeout_seconds": 8,
      "interval_seconds": 1,
      "continue_on_timeout": true,
      "max_iterations": 6,
      "retries": 2
    },
    {
      "match_mode": "exact",
      "retries": 2,
      "skip_if_texts": [
        "已签到"
      ],
      "texts": [
        "签到"
      ],
      "timeout_seconds": 15,
      "type": "click",
      "locate": "ocr"
    },
    {
      "type": "wait",
      "seconds": 5
    },
    {
      "type": "capture_screenshot"
    }
  ]
}
